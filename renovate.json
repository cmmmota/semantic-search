{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "dependencyDashboard": {
    "title": "Renovate Dashboard 🤖"
  },
  "timezone": "Europe/Lisbon",
  "rebaseWhen": "conflicted",
  "automergeSchedule": [
    "* 9-16 * * 1-4"
  ],
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Auto merge minor, patch, pin, and digest updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Auto merge Github Actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Auto merge Docker base image updates",
      "matchManagers": [
        "dockerfile"
      ],
      "automerge": true
    },
    {
      "description": "Group Python dependencies",
      "matchManagers": [
        "pep621"
      ],
      "groupName": "python dependencies"
    },
    {
      "description": "Move the image's Python and .python-version in one PR, so the tests run on the Python the image ships",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python",
        "docker.io/library/python"
      ],
      "groupName": "python"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  }
}
